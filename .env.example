# Ecliptara Observatory - Environment Configuration Template
# NOTE: Ecliptara is a client-side web application.
# API keys can be entered directly in the browser via the Settings dialog (Ctrl+K -> Preferences).
# This template is provided for containerized runners, local proxy setups, or custom server environments.

# Local static server port (default: 4173)
PORT=4173

# NASA Open API Key (default: DEMO_KEY)
# Register for a free key at: https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY
